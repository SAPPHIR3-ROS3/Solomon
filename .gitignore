/solomon*
/cursor-bundler*
/cursor_bundler*
/bin/
/dist/
*node_modules*
/gui/dist/
/gui/*.tsbuildinfo
/gui/package.json.md5
/gui/desktop/build/*
!/gui/desktop/build/appicon.png
/solomon.exe~
/*.exe~
/scripts/cursor-bundler.exe
/scripts/cursor_bundler.exe
.env
/CONTEXT.md
*.DS_Store

# Orchestrate compile slots (under module root during dev)
.solomon/

# Cursor API integration (TypeScript / Node)
integrations/cursor/dist/
integrations/cursor/.test/
integrations/cursor/.solomon-cursor-guard/
integrations/cursor/*.tsbuildinfo
integrations/cursor/.env
integrations/cursor/.env.*
integrations/cursor/npm-debug.log*
integrations/cursor/yarn-debug.log*
integrations/cursor/yarn-error.log*
integrations/cursor/pnpm-debug.log*

# Go embed bundle (generated: go run scripts/cursor_bundler.go bundle)
internal/integrations/cursor/bundle/

# Generated production GUI bundle shared by CLI and Wails
/gui/assets/frontend/*
!/gui/assets/frontend/.keep
