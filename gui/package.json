{
  "name": "solomon-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && cd .. && go run scripts/gui_bundle.go",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "preview": "vite preview",
    "test:mobile": "node --test --test-concurrency=1 e2e/mobile.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.18.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright-core": "1.60.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
