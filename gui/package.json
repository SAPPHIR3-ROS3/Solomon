{
  "name": "solomon-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && cd .. && go run scripts/gui_bundle.go",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:update": "node --test tests/update.test.mjs e2e/updateButton.test.mjs",
    "preview": "vite preview",
    "test:mutation": "node tests/mutation/runner.mjs",
    "benchmark:chat": "node scripts/benchmark-chat-navigation.mjs",
    "test:desktop:linux": "node scripts/benchmark-chat-navigation.mjs --engine webkitgtk --floating-letters --tools --interactions --messages 100,300 --repeats 3 --max-cached-ms 750 --output /tmp/solomon-desktop-chat-performance.json",
    "test:composer": "node --test e2e/composerInteractions.test.mjs",
    "test:composer:desktop": "SOLOMON_TEST_ENGINE=webkitgtk node --test e2e/composerInteractions.test.mjs",
    "test:animation:desktop": "node scripts/benchmark-chat-navigation.mjs --engine webkitgtk --floating-letters --tools --interactions --messages 100,300 --repeats 3 --animation-sample-ms 5000 --min-animation-fps 55 --max-animation-gap-ms 50 --output /tmp/solomon-animation-stability.json",
    "test:mobile": "node --test --test-concurrency=1 e2e/mobile.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-oniguruma": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/types": "^4.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
